{
  "name": "explain-branch",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Command-line tool that turns the current Git branch into a narrated explainer video.",
  "license": "MIT",
  "bin": {
    "explain-branch": "bin/explain-branch.ts"
  },
  "scripts": {
    "inspect": "node bin/explain-branch.ts inspect",
    "plan": "node bin/explain-branch.ts plan",
    "narrate": "node bin/explain-branch.ts narrate",
    "explain": "node bin/explain-branch.ts explain",
    "studio": "remotion studio src/render/index.ts",
    "render:fixture": "remotion render src/render/index.ts ExplainBranch artifacts/render-fixture.mp4",
    "render:narrated": "node bin/explain-branch.ts render",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "browser:ensure": "remotion browser ensure"
  },
  "dependencies": {
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "openai": "^7.27.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
